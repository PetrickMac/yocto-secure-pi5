description: Conventions for BitBake recipes, appends, and config in meta-secure-pi5
globs: ["meta-secure-pi5/**/*.bb", "meta-secure-pi5/**/*.bbappend", "meta-secure-pi5/**/*.bbclass", "meta-secure-pi5/**/*.conf", "meta-secure-pi5/**/*.cfg", "conf-snippets/**"]
alwaysApply: false
